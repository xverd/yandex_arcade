<+>import arcade\n\n# размеры и константы\nSCREEN_WIDTH = 1024\nSCREEN_HEIGHT = 1536\nokno = SCREEN_WIDTH / SCREEN_HEIGHT\n\n\nclass MyGame(arcade.Window):\n    def __init__(self):\n        super().__init__(SCREEN_WIDTH, SCREEN_HEIGHT, \"projectArcade\", resizable=True)\n        self.texture = arcade.load_texture(\"главныйэкран.jpg\")\n        self.set_minimum_size(200, int(200 / okno))  # не падает при минимальном размере окна\n\n    def on_draw(self):\n        self.clear()\n        SCREEN_WIDTH, SCREEN_HEIGHT = self.get_size()\n        arcade.draw_texture_rect(self.texture,\n                                 arcade.rect.XYWH(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, SCREEN_WIDTH,\n                                                  SCREEN_HEIGHT))  # начальный экран\n\n    def on_resize(self, width, height):  # окно изменяющее размер\n        if width <= 0 or height <= 0:\n            return\n        if width / height > okno:\n            width = int(height * okno)\n        else:\n            height = int(width / okno)\n        if (width, height) != self.get_size():\n            self.set_size(width, height)\n            return\n        super().on_resize(width, height)\n\n\nif __name__ == \"__main__\":\n    MyGame()\n    arcade.run()\n
