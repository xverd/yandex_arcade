import arcade

# размеры и константы
SCREEN_WIDTH = 1024
SCREEN_HEIGHT = 1536
okno = SCREEN_WIDTH / SCREEN_HEIGHT


class MyGame(arcade.Window):
    def __init__(self):
        super().__init__(SCREEN_WIDTH, SCREEN_HEIGHT, "projectArcade", resizable=True)
        self.texture = arcade.load_texture("главныйэкран.jpg")
        self.set_minimum_size(200, int(200 / okno))  # не падает при минимальном размере окна

    def on_draw(self):
        self.clear()
        SCREEN_WIDTH, SCREEN_HEIGHT = self.get_size()
        arcade.draw_texture_rect(self.texture,
                                 arcade.rect.XYWH(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, SCREEN_WIDTH,
                                                  SCREEN_HEIGHT))  # начальный экран

    def on_resize(self, width, height):  # окно изменяющее размер
        if width <= 0 or height <= 0:
            return
        if width / height > okno:
            width = int(height * okno)
        else:
            height = int(width / okno)
        if (width, height) != self.get_size():
            self.set_size(width, height)
            return
        super().on_resize(width, height)


if __name__ == "__main__":
    MyGame()
    arcade.run()
